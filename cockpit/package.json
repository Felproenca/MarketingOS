{
  "name": "cockpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.cjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.js\"",
    "registry:validate": "node --input-type=module -e \"import { validateSkillRegistry } from './api/_lib/skill-registry.js'; const r = validateSkillRegistry(); if (!r.ok) { console.error(r.errors.join('\\n')); process.exit(1) } console.log('registry OK:', r.registry.skills.length, 'skills |', r.registry.skills.filter(s => s.status === 'operational').length, 'operational')\"",
    "worker": "node scripts/worker.mjs",
    "worker:once": "node scripts/worker.mjs --once"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
