# MarketingOS — Variáveis de Ambiente (conforme necessário)

# ⚠️  NUNCA commitar este arquivo com dados reais
# Copie para .env e configure localmente

# Anthropic (opcional - para skills futuras)
ANTHROPIC_API_KEY=sk-ant-xxxx...

# Supabase (opcional - quando integrar database)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx...
SUPABASE_SERVICE_ROLE_KEY=xxxx...

# NOTA: generate-image.js usa Pollinations AI (GRATUITO - sem chave necessária)

# Scraper Inteligente v2 — outreach de prospecção
EMAIL_USER=felipe@marketingos.com.br
EMAIL_PASS=sua_senha_de_app_gmail   # Gmail: Configurações > Segurança > Senhas de app
SCRAPER_DELAY_MS=2000               # delay entre análises (respeitar rate limits)
SCRAPER_MAX_LEADS=10                # máximo de leads por execução

# Integração social-content-agents
SOCIAL_AGENT_URL=http://localhost:8000
SOCIAL_AGENT_KEY=

# Motor de DM (comentario DIAGNOSTICO -> DM -> lead magnet)
DM_ENGINE_PORT=4280
DM_SLUG=felipe-proenca
DM_KEYWORD=DIAGNOSTICO
DM_KEYWORDS=DIAGNOSTICO,DIAGNÓSTICO,DIAGNOSTICO!,DIAG,DIAGNOSTICAR
MAGNET_URL=https://seu-dominio-publico.com/
DM_AUTO_SEND=
WEBHOOK_VERIFY_TOKEN=crie_um_token_forte
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
